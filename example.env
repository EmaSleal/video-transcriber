# Backend LLM para clasificación/dedup de categorías: ollama (default, local,
# sin costo) | gpt | claude. Ollama requiere tener Ollama corriendo en
# localhost:11434 con un modelo pulleado (ver OLLAMA_MODEL abajo).
LLM_BACKEND=ollama

# Necesaria solo si LLM_BACKEND=gpt
OPENAI_API_KEY=

# Necesaria solo si LLM_BACKEND=claude
ANTHROPIC_API_KEY=

# Solo si LLM_BACKEND=ollama y tu instalación no es la default
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b

# Tamaño de modelo Whisper para la transcripción batch de video.
# tiny | base | small | medium | large-v3 | large-v3-turbo
WHISPER_MODEL_VIDEO=base

# Idioma de la interfaz: es | en
LANGUAGE=es

# Umbral de distancia (cosine) para el dedup semántico de categorías — solo
# aplica si OPENAI_API_KEY está seteada y chromadb está instalado.
CATEGORY_DEDUP_MAX_DISTANCE=0.15
